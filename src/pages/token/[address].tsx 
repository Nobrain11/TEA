import { GetServerSideProps } from "next";
import { AppShell } from "@/components/AppShell";
import { StatusBadge } from "@/components/StatusBadge";
import { explorerAddressUrl } from "@/services/chainService";
import { fetchTokenByAddress, TokenData } from "@/services/tokenService";
import { shortAddress, formatNumber } from "@/lib/format";

export default function TokenPage({ token }: { token: TokenData }) {
  return (
    <AppShell>
      <div className="space-y-6">
        <div className="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div className="flex items-start justify-between gap-4">
            <div>
              <div className="text-2xl font-semibold">{token.symbol || "Unavailable"}</div>
              <div className="text-zinc-400">{token.name || "Unavailable"}</div>
              <div className="mt-2 text-sm text-zinc-500">{shortAddress(token.address)}</div>
            </div>
            <StatusBadge status={token.status} />
          </div>

          <div className="mt-6 grid gap-4 md:grid-cols-4">
            <div className="rounded-xl bg-zinc-950 p-4">
              <div className="text-xs text-zinc-500">Price</div>
              <div className="mt-1 text-lg">${formatNumber(token.price)}</div>
            </div>
            <div className="rounded-xl bg-zinc-950 p-4">
              <div className="text-xs text-zinc-500">Liquidity</div>
              <div className="mt-1 text-lg">${formatNumber(token.liquidity)}</div>
            </div>
            <div className="rounded-xl bg-zinc-950 p-4">
              <div className="text-xs text-zinc-500">Volume</div>
              <div className="mt-1 text-lg">${formatNumber(token.volume24h)}</div>
            </div>
            <div className="rounded-xl bg-zinc-950 p-4">
              <div className="text-xs text-zinc-500">Market Cap</div>
              <div className="mt-1 text-lg">${formatNumber(token.marketCap)}</div>
            </div>
          </div>

          <div className="mt-6 flex gap-3">
            <a className="rounded-xl bg-teal-600 px-4 py-3 font-medium text-black" href={explorerAddressUrl(token.address)} target="_blank" rel="noreferrer">
              Open Explorer
            </a>
          </div>
        </div>

        <div className="grid gap-6 lg:grid-cols-[1.3fr_0.7fr]">
          <div className="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
            <h2 className="font-semibold">Live Chart</h2>
            <div className="mt-4 flex h-72 items-center justify-center rounded-xl border border-dashed border-zinc-700 text-zinc-500">
              Chart data unavailable in read-only starter
            </div>
          </div>

          <div className="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
            <h2 className="font-semibold">Token Data</h2>
            <div className="mt-4 space-y-2 text-sm text-zinc-300">
              <div>Address: {shortAddress(token.address)}</div>
              <div>Decimals: {token.decimals ?? "Unavailable"}</div>
              <div>Status: {token.status}</div>
              <div>Updated: {token.updatedAt}</div>
            </div>
          </div>
        </div>
      </div>
    </AppShell>
  );
}

export const getServerSideProps: GetServerSideProps = async (ctx) => {
  const address = String(ctx.params?.address || "");
  const token = await fetchTokenByAddress(address);
  return { props: { token } };
};
